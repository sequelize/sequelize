{
  "name": "sequelize",
  "version": "400.49.0",
  "description": "PostgreSQL ORM for Node.JS",
  "keywords": [
    "nodejs",
    "object relational mapper",
    "orm",
    "postgres",
    "postgresql"
  ],
  "bugs": {
    "url": "https://github.com/sequelize/sequelize/issues"
  },
  "license": "MIT",
  "author": "Sascha Depold <sascha@depold.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/sequelize/sequelize.git"
  },
  "files": [
    "lib",
    "index.js",
    "index.d.ts"
  ],
  "main": "index",
  "types": "index.d.ts",
  "scripts": {
    "lint": "oxlint --quiet lib test",
    "test:types": "tsc --noEmit -p tsconfig.json",
    "fmt": "oxfmt --write lib test",
    "fmt:check": "oxfmt --check lib test",
    "test": "pnpm run teaser && pnpm run test-unit && pnpm run test-integration",
    "test-docker": "pnpm run test-docker-unit && pnpm run test-docker-integration",
    "test-docker-unit": "pnpm run test-unit",
    "test-docker-integration": "env-cmd -f ./test/config/.docker.env pnpm run test-integration",
    "teaser": "node -e \"console.log('#'.repeat(process.env.DIALECT.length + 22) + '\\n# Running tests for ' + process.env.DIALECT + ' #\\n' + '#'.repeat(process.env.DIALECT.length + 22))\"",
    "test-unit": "mocha --globals setImmediate,clearImmediate --exit --colors -t 30000 --reporter spec \"test/unit/**/*.js\"",
    "test-unit-postgres": "cross-env DIALECT=postgres pnpm run test-unit",
    "test-unit-postgres-native": "cross-env DIALECT=postgres-native pnpm run test-unit",
    "test-integration": "mocha --globals setImmediate,clearImmediate --exit --colors -t 30000 --reporter spec \"test/integration/**/*.test.js\"",
    "test-integration-postgres": "cross-env DIALECT=postgres pnpm run test-integration",
    "test-integration-postgres-native": "cross-env DIALECT=postgres-native pnpm run test-integration",
    "test-postgres": "cross-env DIALECT=postgres pnpm test",
    "test-postgres-docker": "DIALECT=postgres SEQ_PORT=8996 SEQ_USER=sequelize_test SEQ_PW=sequelize_test SEQ_DB=sequelize_test pnpm test",
    "test-integration-postgres-docker": "DIALECT=postgres SEQ_PORT=8996 SEQ_USER=sequelize_test SEQ_PW=sequelize_test SEQ_DB=sequelize_test pnpm run test-integration",
    "test-pgsql": "pnpm run test-postgres",
    "test-postgres-native": "cross-env DIALECT=postgres-native pnpm test",
    "test-postgresn": "pnpm run test-postgres-native",
    "test-all": "pnpm run test-postgres && pnpm run test-postgres-native",
    "sscce": "env-cmd -f $npm_package_options_env_cmd node sscce.js",
    "sscce-postgres": "cross-env DIALECT=postgres pnpm run sscce"
  },
  "dependencies": {
    "debug": "^4.4.3",
    "depd": "^2.0.0",
    "generic-pool": "3.9.0",
    "inflection": "^3.0.2",
    "lodash": "^4.18.1",
    "moment": "^2.30.1",
    "moment-timezone": "^0.6.3",
    "retry-as-promised": "^3.0.0",
    "semver": "^7.0.0",
    "terraformer-wkt-parser": "^1.1.2",
    "toposort-class": "^1.0.1",
    "uuid": "^14.0.1",
    "validator": "^13.7.0",
    "wkx": "^0.5.0"
  },
  "devDependencies": {
    "@types/cls-hooked": "4.3.9",
    "@types/lodash": "4.17.25",
    "@types/node": "20.19.43",
    "@types/validator": "13.15.10",
    "big-integer": "1.6.52",
    "chai": "6.2.2",
    "chai-as-promised": "8.0.2",
    "cheerio": "1.2.0",
    "cls-hooked": "4.2.2",
    "cross-env": "10.1.0",
    "env-cmd": "11.0.0",
    "hints": "1.1.0",
    "mocha": "11.7.6",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "pg": "8.22.0",
    "pg-hstore": "2.3.4",
    "pg-native": "3.8.0",
    "pg-types": "2.2.0",
    "sinon": "22.1.0",
    "typescript": "7.0.2",
    "uuid-validate": "0.0.3"
  },
  "peerDependencies": {
    "pg": "^8.19.0"
  },
  "engines": {
    "node": ">=20.20.0"
  },
  "volta": {
    "node": "24.18.1",
    "pnpm": "10.34.5"
  },
  "packageManager": "pnpm@10.34.5",
  "options": {
    "env_cmd": "./test/config/.docker.env",
    "mocha": "--globals setImmediate,clearImmediate --exit --colors -t 30000 --reporter spec"
  }
}
