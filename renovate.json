{
  "extends": [
    "config:recommended",
    ":maintainLockFilesWeekly",
    ":semanticCommitTypeAll(meta)",
    ":semanticCommitScopeDisabled"
  ],
  "automergeStrategy": "squash",
  "automergeType": "branch",
  "branchConcurrentLimit": 2,
  "semanticCommitType": "meta",
  "ignorePaths": ["dev/**/oldest/docker-compose.yml"],
  "platformAutomerge": true,
  "packageRules": [
    {
      "matchUpdateTypes": ["minor", "patch", "pin", "digest", "lockFileMaintenance"],
      "automerge": true
    },
    {
      "matchDatasources": ["npm"],
      "minimumReleaseAge": "1 day"
    },
    {
      "groupName": "inquirer",
      "matchPackageNames": ["@inquirer/*"]
    },
    {
      "groupName": "lerna and nx",
      "matchPackageNames": ["lerna", "nx"]
    },
    {
      "groupName": "oclif",
      "matchPackageNames": ["oclif", "@oclif/*"]
    }
  ],
  "rangeStrategy": "bump",
  "labels": ["no-autoupdate"],
  "postUpdateOptions": ["yarnDedupeHighest"]
}
